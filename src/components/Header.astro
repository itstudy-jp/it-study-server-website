---
import "../styles/global.css";
import Logo from "../assets/NekoLogo.svg";
---

<header>
  <style>
    .pc-header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      background-color: var(--bg-color);
      font-size: var(--header-font-size);
    }
    .phone-header {
      display: none;
    }
    .pc-logo img {
      height: 10rem;
      margin-right: 2rem;
      align-items: center;
    }
    .phone-logo {
      display: none;
    }
    .members-link {
      display: flex;
      text-align: center;
      font-size: 2.5rem;
      align-items: center;
      justify-content: flex-end;
      padding-right: 8rem;
      list-style: none;
    }
    .mode-icon {
      display: flex;
      text-align: center;
      margin-bottom: 0.5rem;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    .dark-mode-toggle {
      display: flex;
      justify-content: center;
      align-items: center;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 2.5rem;
      margin-left: 1rem;
      color: inherit;
      text-align: center;
      width: 2.5rem;
    }
    .title {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin-left: 5rem;
      font-size: 2.5rem;
    }

    @media screen and (max-width: 1000px) {
      .section-main {
        margin-top: 3%;
        margin-right: 50%;
        margin-left: 5%;
        text-align: left;
      }
      .members-link {
        display: flex;
        flex-direction: column;
      }
      .pc-header {
        display: none;
      }
      .phone-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        background-color: var(--bg-color);
        font-size: var(--header-font-size);
        font-size: 2.3rem;
      }
      .pc-logo img {
        display: none;
      }
      .phone-logo {
        display: flex;
      }
      .phone-logo img {
        width: 8.5rem;
      }
    }
  </style>
  <meta
    name="google-site-verification"
    content="8zcm0HGKGIe9e5w9dEIKUVNd28FDH5wlUM4IP-tFgj4"
  />
  <div class="pc-header">
    <div class="title">
      <a href="/it-study-server-website/" class="pc-logo">
        <img src={Logo.src} alt="Logo" />
      </a>
      <div>IT学習サーバー</div>
    </div>
    <div class="members-link">
      <a href="/it-study-server-website/members">コアメン達</a>
      <button class="dark-mode-toggle" aria-label="ダークモード切り替え">
        <div id="mode-icon" class="mode-icon">
          <script src="../scripts/change-light-dark.js"></script>☀
        </div>
      </button>
    </div>
  </div>
  <div class="phone-header">
    <a href="/it-study-server-website/" class="phone-logo">
      <img src={Logo.src} alt="Logo" />
    </a>
    <span class="logo">IT学習サーバー</span>
  </div>
</header>
