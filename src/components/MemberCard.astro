---
import githubIcon from "../assets/Github.svg";
// import XIcon from "../assets/X.svg";

export interface Props {
  githubUrl: string;
  xUrl: string;
  imgUrl: string;
  name: string;
  title: string;
  personalPageLink: string;
}

const { githubUrl, xUrl, imgUrl, name, title,personalPageLink } = Astro.props as Props;
---

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    background: var(--card-color);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    height: auto;
    width: auto;
    padding-bottom: 1rem;
  }
  .card:hover {
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.15);
  }
  .card-header {
    display: flex;
    flex-direction: row;
  }
  .member-icon {
    position: relative;
    width: 5rem;
    height: 5rem;
    padding-right: 1rem;
  }
  .card-info {
    display: flex;
    flex-direction: column;
    justify-items: center;
    padding-top: 1rem;
    width: 20rem;
  }
  .name {
    text-align: left;
    font-size: 1.5rem;
  }
  .title {
    text-align: left;
    font-size: 1rem;
  }
  .description {
    padding-top: 1rem;
    padding-left: 1rem;
    text-align: left;
    font-size: 1.2rem;
    line-height: 1.4; /* 行間を調整 */
  }
  .icons {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    width: 100%;
  }
  .x-icon,
  .github-icon {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    position: relative;
    margin-right: 1rem;
    align-items: center;
    height: 100%;
    width: auto;
  }
  .x-icon img,
  .github-icon img {
    display: flex;
    height: 100%;
    width: 3rem;
  }
</style>

<div class="card">
  <div class="card-header" >
    <a  href={personalPageLink} target="”_blank”">
    <img src={imgUrl} alt="Icon" class="member-icon"  />
    </a>
    <div class="card-info">
      <div class="name">{name}</div>
      <div class="title">{title}</div>
    </div>
    <div class="icons">
      <!-- <a class="x-icon" target=”_blank”>
        <img src={XIcon.src} alt="X" />
      </a> -->
      <a class="github-icon" href={githubUrl} target="”_blank”"
        ><img src={githubIcon.src} alt="GitHub" /></a
      >
    </div>
  </div>
  <div class="description">
    <slot />
  </div>
</div>
